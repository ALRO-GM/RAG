# Internal Caddy of RAGPutin (container ragputin-web). Plain HTTP: TLS is
# terminated by the Peer4U Caddy, which proxies rag.peer4u.app here.
#
# It serves the transcriber's pages from /srv, passes the workstation's
# tunnel (a WebSocket on /_tunnel) to the chisel server of the `tunnel`
# container, and passes /api/* to the port that tunnel opens for the
# workstation's API (docs/DEPLOYMENT.md). Nothing is stored here: audio
# and transcripts only pass through.
{
	auto_https off
	admin off
	servers {
		# The Peer4U Caddy reaches this container over the private docker
		# network and sets X-Forwarded-For to the address it saw (it
		# drops whatever an untrusted caller sent). Trusting only those
		# proxies, read right to left, makes {client_ip} that address.
		# TRUSTED_PROXIES (compose.yml) narrows them; on the server it is
		# the subnet of sanatorio_default. Default: every private range.
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
		timeouts {
			read_header 30s
			idle 5m
		}
	}
}

:80 {
	# No access log: the access code is never in a URL anyway.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; media-src 'self'; worker-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}

	# Answered here, so it works with the workstation off.
	handle /healthz {
		header Content-Type "application/json"
		header Cache-Control "no-store"
		respond `{"status":"ok"}` 200
	}

	# The workstation's chisel client: a WebSocket upgrade on exactly
	# /_tunnel, nothing else. Plain requests never reach chisel (they
	# get the static 404), so its /health and /version stay internal.
	@tunnel {
		path /_tunnel
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @tunnel {
		reverse_proxy tunnel:8080
	}
	handle /_tunnel* {
		respond 404
	}

	handle /api/* {
		# A bit above the API's largest body (an uploaded recording,
		# 256 MiB); the API checks its own, smaller, limits per route.
		request_body {
			max_size 260MiB
		}
		# The port the workstation's reverse tunnel opens in the tunnel
		# container (only while the workstation is connected).
		reverse_proxy tunnel:9000 {
			# The only client address the API trusts, overwriting any
			# value the caller sent; the forwarding headers are not
			# needed by the API and are not passed on.
			header_up X-Client-IP {client_ip}
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up -Forwarded
			# Stream audio ranges and answers as they come.
			flush_interval -1
			transport http {
				dial_timeout 5s
				# An enrolment waits for a running transcription job.
				response_header_timeout 15m
			}
		}
	}

	handle {
		root * /srv
		encode zstd gzip
		# Plain file names (no hashes): always revalidate the app, so a
		# deploy never mixes old and new modules.
		@app path / /index.html /version.json *.js *.css
		header @app Cache-Control "no-cache"
		@icon path *.svg
		header @icon Cache-Control "public, max-age=3600"
		file_server
	}

	# A body over request_body's limit, refused before it reaches the API.
	handle_errors 413 {
		header Content-Type "application/json"
		header Cache-Control "no-store"
		respond `{"code":"payload_too_large","message":"The body is too large."}` 413
	}

	# The tunnel is down or the workstation is off.
	handle_errors 502 503 504 {
		header Content-Type "application/json"
		header Cache-Control "no-store"
		respond `{"code":"workstation_unavailable","message":"The workstation is not available."}` {err.status_code}
	}
}
