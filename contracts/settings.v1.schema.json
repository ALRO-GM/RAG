{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "settings.v1",
  "title": "Pipeline settings saved from the web's «Ajustes» page",
  "description": "One choice per pipeline step with measured alternatives; the first option of every step is the service's own configuration. Owned by the RAG (data/settings.json, GET/PUT /settings); read by the transcriber and the orchestrator when a job or session starts. See docs/SETTINGS.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "preset",
    "choices"
  ],
  "properties": {
    "schema": {
      "const": "settings.v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Grows by one at every save; a writer sending an older one is refused (409)."
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "preset": {
      "enum": [
        "quality",
        "balanced",
        "cost",
        "custom"
      ]
    },
    "choices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transcription.recogniser": {
          "enum": [
            "whisper-large-v3-turbo",
            "whisper-large-v3"
          ]
        },
        "transcription.diarizer": {
          "enum": [
            "auto",
            "diarizen",
            "nemotron",
            "pyannote",
            "builtin"
          ]
        },
        "transcription.names": {
          "enum": [
            "qwen3-8b",
            "qwen3-4b",
            "rules"
          ]
        },
        "live.asr": {
          "enum": [
            "gpu",
            "cpu"
          ]
        },
        "live.diarization": {
          "enum": [
            "on",
            "off"
          ]
        },
        "live.suggester_model": {
          "enum": [
            "haiku",
            "sonnet",
            "opus"
          ]
        },
        "live.suggester_effort": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "live.deadline": {
          "enum": [
            "product",
            "1800",
            "2800"
          ]
        },
        "live.assist_mode": {
          "enum": [
            "pincelada",
            "guiado"
          ]
        },
        "live.max_suggestions": {
          "enum": [
            "3",
            "1",
            "2",
            "5"
          ]
        },
        "live.show_employee": {
          "enum": [
            "on",
            "off"
          ]
        },
        "live.show_other": {
          "enum": [
            "on",
            "off"
          ]
        },
        "analysis.judge": {
          "enum": [
            "claude_code",
            "local",
            "both",
            "opencode"
          ]
        },
        "analysis.confirmation_model": {
          "enum": [
            "opus",
            "sonnet",
            "haiku"
          ]
        },
        "analysis.assessment_model": {
          "enum": [
            "opus",
            "sonnet",
            "haiku"
          ]
        },
        "analysis.synthesis_model": {
          "enum": [
            "opus",
            "sonnet",
            "haiku"
          ]
        },
        "analysis.local_judge": {
          "enum": [
            "qwen3-8b",
            "qwen3-4b"
          ]
        },
        "analysis.act_tagger": {
          "enum": [
            "encoder",
            "combined",
            "rules"
          ]
        },
        "knowledge.ocr": {
          "enum": [
            "on",
            "off"
          ]
        },
        "knowledge.captions": {
          "enum": [
            "florence",
            "claude",
            "off"
          ]
        },
        "voicebot.reasoner_model": {
          "enum": [
            "haiku",
            "sonnet",
            "opus"
          ]
        },
        "voicebot.voice": {
          "anyOf": [
            {
              "enum": [
                "davefx",
                "sharvard"
              ]
            },
            {
              "type": "string",
              "pattern": "^clone:[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
              "description": "The enrolled person's own voice (cloned; needs their consent to cloning, else Piper davefx)."
            }
          ]
        },
        "voicebot.length_scale": {
          "type": "string",
          "pattern": "^[0-9]{1,2}(\\.[0-9]{1,3})?$",
          "description": "Piper length scale (larger is slower); default 1. A number from 0.7 to 1.5 as text, at most three decimals."
        },
        "voicebot.noise_scale": {
          "type": "string",
          "pattern": "^[0-9]{1,2}(\\.[0-9]{1,3})?$",
          "description": "Piper noise scale (intonation variation); default 0.5, the voices' own. A number from 0 to 1 as text, at most three decimals."
        },
        "voicebot.noise_w": {
          "type": "string",
          "pattern": "^[0-9]{1,2}(\\.[0-9]{1,3})?$",
          "description": "Piper noise_w (cadence, phoneme length variation); default 0.333, the voices' own. A number from 0 to 1 as text, at most three decimals."
        },
        "voicebot.sentence_silence": {
          "type": "string",
          "pattern": "^[0-9]{1,2}(\\.[0-9]{1,3})?$",
          "description": "Seconds of silence after each sentence; default 0. A number from 0 to 1 as text, at most three decimals."
        },
        "voicebot.match_rate": {
          "anyOf": [
            {
              "enum": [
                "off"
              ]
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
              "description": "An enrolled person whose measured speaking rate (words/s) sets the length scale."
            }
          ]
        },
        "interview.slot_filler": {
          "enum": [
            "haiku",
            "heuristic"
          ]
        },
        "interview.max_probes": {
          "enum": [
            "1",
            "0",
            "2"
          ]
        },
        "interview.minutes": {
          "enum": [
            "20",
            "15",
            "30",
            "45"
          ]
        },
        "interview.post_call": {
          "enum": [
            "off",
            "on"
          ]
        },
        "interview.turn_silence_s": {
          "type": "string",
          "pattern": "^[0-9]{1,2}(\\.[0-9]{1,3})?$",
          "description": "Seconds of silence after the candidate's last speech that end a finished-looking answer; default 3.5. A number from 2 to 6 as text."
        },
        "interview.think_s": {
          "type": "string",
          "pattern": "^[0-9]{1,2}(\\.[0-9]{1,3})?$",
          "description": "Seconds the interviewer stays silent after a question before any reaction; default 6. A number from 3 to 15 as text."
        },
        "interview.max_wait_s": {
          "type": "string",
          "pattern": "^[0-9]{1,2}(\\.[0-9]{1,3})?$",
          "description": "Longest silence in seconds: before re-asking a question with no answer (once) and before ending an unfinished-looking answer; default 10. A number from 5 to 20 as text."
        },
        "interview.stuck_s": {
          "type": "string",
          "pattern": "^[0-9]{1,2}(\\.[0-9]{1,3})?$",
          "description": "Seconds of silence after part of an answer before one hint on how to go on (one per slot); default 7. A number from 4 to 15 as text."
        },
        "interview.backchannel": {
          "enum": [
            "voice",
            "visual",
            "off"
          ],
          "description": "Active listening during long answers: short spoken tokens and the page's indicator (voice), the indicator only (visual), or nothing."
        }
      }
    }
  }
}
