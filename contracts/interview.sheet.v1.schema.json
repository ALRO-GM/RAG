{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interview.sheet.v1",
  "title": "Slot sheet of one AI interview (#208)",
  "description": "The plan's slots after the interview: status (filled, partial, empty, skipped, unknown = \"no lo conoce\"), the candidate's answers with transcript utterance ids and quotes, a 0-100 score relative to what the offer requires with the scorer's confidence, the weighted suitability and other useful skills; added compatibly (#258), per point of a slot whether the candidate talked about it (treated, pending, unknown = said they do not know it) with the quote and utterance that settled it, a hint and not a judgement of the answer. Added compatibly (#259): a judgement of how accurate the answers to each slot and each treated concept were (solid, correct_basic, wrong, off_topic, unclear, to_verify for unverifiable experience claims) with the quote, utterance, a one-sentence reason and its basis (domain documents with chunk ids, or the model's general knowledge); per-slot accuracy counts; to_check, statements worth checking (a prompt, never a verdict); judge, the template that judged. Added compatibly (#262): kind, ai (the AI interviewer) or live (a live-page round: judgements only, never a score), and candidate_id; kept in the candidate's file until a person deletes it. Added compatibly (#267): report_error, why the model did not score or judge it (status and error kind; the scores are then the status estimate). A draft for the recruiter, never shown to the candidate. Producer: orchestrator (data/interview/results).",
  "$defs": {
    "Answer": {
      "additionalProperties": false,
      "description": "One candidate utterance that answers a slot.",
      "properties": {
        "utterance": {
          "title": "Utterance",
          "type": "string"
        },
        "quote": {
          "maxLength": 300,
          "title": "Quote",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "utterance",
        "quote",
        "status"
      ],
      "title": "Answer",
      "type": "object"
    },
    "CheckItem": {
      "additionalProperties": false,
      "description": "A statement that is worth checking (#259): a prompt, not a verdict.\n\n``why``: it looks incorrect, it contradicts another answer of the\nsame interview, or it is confident but vague where specifics were\nasked.",
      "properties": {
        "slot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot"
        },
        "quote": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "utterance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Utterance"
        },
        "why": {
          "enum": [
            "wrong",
            "contradiction",
            "vague"
          ],
          "title": "Why",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 300,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "quote",
        "why"
      ],
      "title": "CheckItem",
      "type": "object"
    },
    "Judgement": {
      "additionalProperties": false,
      "description": "A model's judgement of one answer, for the recruiter (#259).\n\n``basis`` says what it rests on: retrieved ``documents`` of the\nplan's knowledge domain (``cites``), or the model's ``general``\nknowledge. A draft: the model can be wrong about facts.",
      "properties": {
        "label": {
          "enum": [
            "solid",
            "correct_basic",
            "wrong",
            "off_topic",
            "unclear",
            "to_verify"
          ],
          "title": "Label",
          "type": "string"
        },
        "reason": {
          "default": "",
          "maxLength": 300,
          "title": "Reason",
          "type": "string"
        },
        "quote": {
          "default": "",
          "maxLength": 300,
          "title": "Quote",
          "type": "string"
        },
        "utterance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Utterance"
        },
        "basis": {
          "default": "general",
          "enum": [
            "documents",
            "general"
          ],
          "title": "Basis",
          "type": "string"
        },
        "cites": {
          "items": {
            "type": "string"
          },
          "title": "Cites",
          "type": "array"
        }
      },
      "required": [
        "label"
      ],
      "title": "Judgement",
      "type": "object"
    },
    "OtherSkill": {
      "additionalProperties": false,
      "description": "A skill the candidate showed that the offer did not ask for.",
      "properties": {
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "quote": {
          "default": "",
          "maxLength": 300,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "OtherSkill",
      "type": "object"
    },
    "SheetPoint": {
      "additionalProperties": false,
      "description": "One concept of a slot after the interview (#258).\n\n``treated``: the candidate talked about it; ``pending``: not yet;\n``unknown``: they said they do not know it. ``quote`` and\n``utterance`` are the words that settled it. ``judgement`` (#259):\nhow accurate what they said about it was, for a treated concept\nthe report judged.\n``by`` (#268): who decided the status: the word ``rules`` during the session, a ``live_model`` call during the session (the AI interviewer's slot filler, the live page's tick call) or the model reading the whole round ``after_session``; absent or null on sheets written before it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "enum": [
            "treated",
            "pending",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "quote": {
          "default": "",
          "maxLength": 300,
          "title": "Quote",
          "type": "string"
        },
        "utterance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Utterance"
        },
        "judgement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Judgement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "by": {
          "anyOf": [
            {
              "enum": [
                "rules",
                "live_model",
                "after_session"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "SheetPoint",
      "type": "object"
    },
    "SheetSlot": {
      "additionalProperties": false,
      "description": "One slot of the sheet: its status, answers and score.\n\n``score`` (0–100) is the level shown **relative to what the offer\nasks** (100: meets the requirement for this job), ``above`` says the\nevidence goes beyond it, ``confidence`` (0–1) how sure the scorer\nis and ``scored_by`` which scorer gave it (``model`` or\n``status``, a coarse estimate from the slot's status). For the\nrecruiter only; never said to the candidate.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "level": {
          "enum": [
            "minimo",
            "deseable",
            "opcional"
          ],
          "title": "Level",
          "type": "string"
        },
        "weight": {
          "default": 3,
          "title": "Weight",
          "type": "integer"
        },
        "competency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Competency"
        },
        "status": {
          "default": "empty",
          "enum": [
            "filled",
            "partial",
            "empty",
            "skipped",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "asked": {
          "default": 0,
          "title": "Asked",
          "type": "integer"
        },
        "probes": {
          "default": 0,
          "title": "Probes",
          "type": "integer"
        },
        "answers": {
          "items": {
            "$ref": "#/$defs/Answer"
          },
          "title": "Answers",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "above": {
          "default": false,
          "title": "Above",
          "type": "boolean"
        },
        "notes": {
          "default": "",
          "maxLength": 300,
          "title": "Notes",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "scored_by": {
          "anyOf": [
            {
              "enum": [
                "model",
                "status"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scored By"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/SheetPoint"
          },
          "title": "Points",
          "type": "array"
        },
        "judgement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Judgement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "accuracy": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Accuracy",
          "type": "object"
        }
      },
      "required": [
        "id",
        "label",
        "level"
      ],
      "title": "SheetSlot",
      "type": "object"
    },
    "PointAsked": {
      "additionalProperties": false,
      "description": "When and how a concept's question was asked in a live round (#286).\n\n``at``: seconds from the start of the session (the interviewer's\nline; ``None`` when unknown, as for a mark by hand without a line).\n``utterance`` and ``quote``: the interviewer's line and its first\nwords (none for a mark by hand).",
      "properties": {
        "by": {
          "enum": [
            "rules",
            "live_model",
            "hand",
            "after_session"
          ],
          "title": "By",
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "utterance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Utterance"
        },
        "quote": {
          "default": "",
          "maxLength": 300,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "by"
      ],
      "title": "PointAsked",
      "type": "object"
    },
    "PointCoverage": {
      "additionalProperties": false,
      "description": "One concept of a topic: was it asked, and did the candidate treat it.\n\nThe two facts are separate (#286): a concept whose question was\nasked counts as covered even when the answer was poor or absent;\n``status`` is the candidate's side, as in :class:`SheetPoint`.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 80,
          "title": "Text",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "enum": [
            "treated",
            "pending",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "asked": {
          "anyOf": [
            {
              "$ref": "#/$defs/PointAsked"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "undone": {
          "items": {
            "$ref": "#/$defs/PointAsked"
          },
          "title": "Undone",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "PointCoverage",
      "type": "object"
    },
    "TopicCoverage": {
      "additionalProperties": false,
      "description": "How far one topic of the plan was covered in a live round (#286).\n\n``level`` only grows during the session; ``concepts`` the topic's\nconcepts, ``asked`` how many were asked, ``treated`` how many the\ncandidate treated or said they do not know, ``covered`` how many\nwere asked or treated, ``words`` how many words the candidate said\nin answers to it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 120,
          "title": "Label",
          "type": "string"
        },
        "level": {
          "default": "none",
          "enum": [
            "none",
            "named",
            "treated",
            "well_treated"
          ],
          "title": "Level",
          "type": "string"
        },
        "concepts": {
          "default": 0,
          "title": "Concepts",
          "type": "integer"
        },
        "asked": {
          "default": 0,
          "title": "Asked",
          "type": "integer"
        },
        "treated": {
          "default": 0,
          "title": "Treated",
          "type": "integer"
        },
        "covered": {
          "default": 0,
          "title": "Covered",
          "type": "integer"
        },
        "words": {
          "default": 0,
          "title": "Words",
          "type": "integer"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/PointCoverage"
          },
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "TopicCoverage",
      "type": "object"
    },
    "ListUsed": {
      "additionalProperties": false,
      "description": "The list of «Lo que hay que decir» a live round used (#294).",
      "properties": {
        "id": {
          "maxLength": 72,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "general": {
          "default": false,
          "title": "General",
          "type": "boolean"
        },
        "version": {
          "default": 0,
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "add",
                "replace"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "domain": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "instead_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/ListLost"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A recovered round whose recorded list version was gone: the general list stood in for this one."
        }
      },
      "required": [
        "id"
      ],
      "title": "ListUsed",
      "type": "object"
    },
    "ListLost": {
      "additionalProperties": false,
      "description": "The list and version a round recorded, no longer readable.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "maxLength": 72,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "title": "ListLost",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "interview.sheet.v1",
      "default": "interview.sheet.v1",
      "title": "Schema",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "plan_revision": {
      "default": 0,
      "title": "Plan Revision",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "state": {
      "default": "running",
      "enum": [
        "running",
        "closed",
        "stopped"
      ],
      "title": "State",
      "type": "string"
    },
    "closed_by": {
      "anyOf": [
        {
          "enum": [
            "covered",
            "time",
            "stopped"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Closed By"
    },
    "turns": {
      "default": 0,
      "title": "Turns",
      "type": "integer"
    },
    "elapsed_s": {
      "default": 0.0,
      "title": "Elapsed S",
      "type": "number"
    },
    "minutes": {
      "default": 20,
      "title": "Minutes",
      "type": "integer"
    },
    "minimums_covered": {
      "default": false,
      "title": "Minimums Covered",
      "type": "boolean"
    },
    "turns_to_minimums": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turns To Minimums"
    },
    "slots": {
      "items": {
        "$ref": "#/$defs/SheetSlot"
      },
      "title": "Slots",
      "type": "array"
    },
    "kind": {
      "default": "ai",
      "enum": [
        "ai",
        "live"
      ],
      "title": "Kind",
      "type": "string"
    },
    "candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Id"
    },
    "filler": {
      "default": "heuristic",
      "title": "Filler",
      "type": "string"
    },
    "candidate": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate"
    },
    "suitability": {
      "anyOf": [
        {
          "maximum": 100.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suitability"
    },
    "summary": {
      "default": "",
      "maxLength": 1200,
      "title": "Summary",
      "type": "string"
    },
    "other_skills": {
      "items": {
        "$ref": "#/$defs/OtherSkill"
      },
      "title": "Other Skills",
      "type": "array"
    },
    "scorer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scorer"
    },
    "to_check": {
      "items": {
        "$ref": "#/$defs/CheckItem"
      },
      "title": "To Check",
      "type": "array"
    },
    "judge": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Judge"
    },
    "report_error": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Report Error"
    },
    "attribution": {
      "anyOf": [
        {
          "enum": [
            "rules",
            "after_session"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attribution",
      "description": "Who said which utterances answer each point of a live round (#268): the model reading the whole round after the session, or the word rules of the session (the model was not asked or failed). Null: an AI interviewer's sheet, or one written before it."
    },
    "attribution_error": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attribution Error",
      "description": "Why the model's attribution was not used: its status and error kind, never the candidate's words."
    },
    "plan_slots": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Slots",
      "description": "The slot ids of the plan revision the interview was made with (#271): a point of the plan in this list but not in slots was not treated; one in neither was added to the plan later (not asked). Null: written before it."
    },
    "coverage": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/TopicCoverage"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coverage",
      "description": "How far each topic of the plan was covered in a live round (#286): its level (none, named, treated, well_treated; it only grows) and counts, and per concept whether its question was asked (by rules, live_model, hand or after_session; when, in seconds from the start; the interviewer's line and words) and whether the candidate treated it; marks the interviewer undid by hand (`undone`). Null: an AI interviewer's sheet, or a live report written before it."
    },
    "mandatory_list": {
      "anyOf": [
        {
          "$ref": "#/$defs/ListUsed"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mandatory List",
      "description": "The list of «Lo que hay que decir» of a live round and its version (#294; a later edit of the list never changes it). Null: an AI interviewer's sheet, or one written before it."
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    }
  },
